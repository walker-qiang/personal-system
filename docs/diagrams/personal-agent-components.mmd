%%{init: {"theme": "base", "flowchart": {"curve": "basis", "htmlLabels": true, "nodeSpacing": 24, "rankSpacing": 34}, "themeVariables": {"fontFamily": "Arial, PingFang SC, sans-serif", "lineColor": "#64748b", "textColor": "#172033"}}}%%
flowchart LR
    CLIENT["personal-os Agent Gateway<br/>JWT + HTTP/SSE"]:::external

    subgraph SERVICE["Service Boundary"]
        direction TB
        ROUTES["FastAPI Routes<br/>chat / sessions / runtime / skills / tools"]:::service
        BOOT["Auth / Middleware / Lifecycle<br/>stream ticket / rate limit / registry 初始化"]:::service
    end

    subgraph APP["Agent Application / Orchestration"]
        direction TB
        CHAT["ChatService<br/>请求、会话与 SSE 事件"]:::application
        AGENTS["Commander + Domain Agents<br/>Registry / Presets"]:::application
        GRAPH["LangGraph + fixed workflows<br/>plan / DAG / deep research"]:::application
        CONTEXT["Context + Guardrails<br/>DataBus / budget / compaction / privacy"]:::application
        KNOWLEDGE["Skills / RAG / Memory Evolution"]:::application
    end

    subgraph RUNTIME["Independent Runtime Boundary"]
        direction TB
        BRIDGE["Runtime Adapter<br/>Application request -> RunRequest"]:::runtime
        CORE["Runtime Core<br/>model-tool loop<br/>operation / event / approval / effect"]:::runtimecore
        PORTS["通用 Ports<br/>Model / ToolExecutor / Context / Store"]:::runtime
    end

    subgraph ADAPTERS["Adapters & Application Infrastructure"]
        direction TB
        MODELADAPTER["Model Adapter"]:::adapter
        TOOLEXEC["ToolExecutor Adapter<br/>Tool Registry"]:::adapter
        STORE["SQLiteRuntimeStore<br/>operation durable journal"]:::adapter
        VAULTCLIENT["Vault Client<br/>Memory / Skill mutation"]:::adapter
        TRACE["TraceLogger / OTel<br/>application tool trace"]:::adapter
        RAGINDEX["RAG / embedding index"]:::adapter
    end

    PROVIDERS["LLM / Web / MCP providers"]:::external
    OS["personal-os API<br/>Tool Provider / Vault / Writeback"]:::os
    VAULT["personal-assets<br/>Skills / RAG / Memory projection"]:::asset
    FINDB["shared finance.sqlite<br/>兼容只读 projection"]:::runtime_state
    AGSTATE["personal-agent var/<br/>sessions / Runtime / checkpoints / trace / RAG"]:::runtime_state

    CLIENT --> ROUTES
    BOOT --> ROUTES
    ROUTES --> CHAT
    CHAT --> AGENTS
    AGENTS --> GRAPH
    GRAPH --> CONTEXT
    GRAPH --> KNOWLEDGE
    GRAPH --> BRIDGE
    BRIDGE --> CORE
    CORE --> PORTS

    PORTS --> MODELADAPTER
    PORTS --> TOOLEXEC
    PORTS --> STORE
    MODELADAPTER --> PROVIDERS
    TOOLEXEC --> PROVIDERS
    TOOLEXEC -->|"personal_os.* / writeback"| OS
    OS -->|"tool / operation result"| TOOLEXEC
    TOOLEXEC -->|"finance.* 只读"| FINDB
    STORE --> AGSTATE

    KNOWLEDGE -.->|"配置路径只读加载"| VAULT
    KNOWLEDGE --> RAGINDEX
    RAGINDEX --> AGSTATE
    ROUTES -->|"Memory / Skill API"| VAULTCLIENT
    CHAT -->|"profile sync"| VAULTCLIENT
    VAULTCLIENT -->|"/api/vault/*"| OS
    OS -->|"AssetStore durable write"| VAULT
    CHAT --> TRACE
    TOOLEXEC --> TRACE
    TRACE --> AGSTATE

